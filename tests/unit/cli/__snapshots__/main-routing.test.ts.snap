// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`cli main routing > preserves help output for 'backend' via snapshot 1`] = `
"Usage: coral-cli backend [options] [command]

Backend administration and local incident inspection

Options:
  -h, --help             display help for command

Commands:
  status                 Show backend daemon status
  shutdown               Gracefully shut down backend daemon
  store-adopt [options]  Adopt a same-generation legacy store into the generated
                         state boundary
  store-reset            Inspect retained store-reset incidents
  kb-commit              Operate on retained blocking KB commit evidence
  help [command]         display help for command
"
`;

exports[`cli main routing > preserves help output for 'codex' via snapshot 1`] = `
"Usage: coral-cli codex [options] [agent]

Run via codex; Coral captures and binds the provider profile selected in the
invoking shell (built-ins: CODEX_HOME, default ~/.codex; CLAUDE_CONFIG_DIR,
default ~/.claude).

Arguments:
  agent                          Agent name (optional; omit for a raw prompt
                                 run)

Options:
  -i, --input <text-or-file...>  Prompt text or file path (multiple tokens are
                                 joined with spaces; a single existing path is
                                 read as a file)
  -w, --work-dir <path>          Working directory
  -m, --model <model>            Model override
  -o, --owner <id>               Owner ID for memo isolation
  -b, --bypass-permissions       Bypass permission checks
  -d, --detach                   Return launch decision without waiting
  -h, --help                     display help for command
"
`;

exports[`cli main routing > preserves help output for 'discuss' via snapshot 1`] = `
"Usage: coral-cli discuss [options] [command]

Discussion operations

Options:
  -h, --help             display help for command

Commands:
  seed [options]         Generate discussion personas
  start [options]        Start a discussion; binds only the provider profiles
                         used by its agents
  watch [options]        Fetch discussion events since cursor (returns new
                         events; increment cursor for next call)
  participate [options]  Submit bid or speech
  abort [options]        Abort a discussion session
  help [command]         display help for command
"
`;

exports[`cli main routing > preserves help output for 'expansion' via snapshot 1`] = `
"Usage: coral-cli expansion [options] [command]

Manage expansion packages

Options:
  -h, --help             display help for command

Commands:
  list                   List installed and available expansions
  equip <name>           Install or activate an expansion
  unequip <name>         Remove an expansion from the coordinator catalog and
                         local install
  remove-catalog <name>  Remove a catalog entry or clean up artifacts from a
                         retired expansion
  update <name>          Update an installed expansion
  info <name>            Show expansion metadata and install state
  help [command]         display help for command
"
`;

exports[`cli main routing > preserves help output for 'kb memo' via snapshot 1`] = `
"Usage: coral-cli kb memo [options] [command]

Manage project memos

Options:
  -h, --help                  display help for command

Commands:
  write [options]             Write a memo with auto-generated timestamp and
                              frontmatter
  list [options]              List project memos
  delete [options] <pattern>  Delete project memos by simple glob pattern
  purge [options]             Delete all project memos
  help [command]              display help for command
"
`;

exports[`cli main routing > preserves help output for 'kb source' via snapshot 1`] = `
"Usage: coral-cli kb source [options] [command]

Manage KB sources

Options:
  -h, --help               display help for command

Commands:
  import [options] <file>  Import a source file into the KB
  list [options]           List KB sources
  delete <slug>            Delete a KB source
  help [command]           display help for command
"
`;

exports[`cli main routing > preserves help output for 'kb' via snapshot 1`] = `
"Usage: coral-cli kb [options] [command]

Knowledge base operations

Options:
  -h, --help                display help for command

Commands:
  search [options] <query>  Search KB entries
  diagnose [options]        Show KB entries with pending manual repair actions
  principles [options]      List KB principles
  source                    Manage KB sources
  community                 Manage KB community summaries
  wiki                      Manage KB wikis
  memo                      Manage project memos
  read [options] <note>     Read a KB entry by slug or explicit selector
  promote [options]         Promote a memo into a KB note. To attach the new
                            note to a wiki, use \`kb wiki adopt\`.
  update [options] <note>   Update an existing KB note
  delete <note>             Delete a KB note
  wake-up                   Generate the KB wake-up packet
  reindex [options]         Rebuild the KB index
  help [command]            display help for command
"
`;

exports[`cli main routing > preserves help output for 'workflow' via snapshot 1`] = `
"Usage: coral-cli workflow [options]

Execute a workflow; binds every provider profile referenced by the workflow for
its full lifetime

Options:
  -e, --expression <expr>               Pipeline DSL expression
  -s, --start-prompt <text-or-file...>  Start prompt text or file path (multiple
                                        tokens are joined with spaces; a single
                                        existing path is read as a file)
  -c, --context <text-or-file...>       Shared context text or file path
                                        (multiple tokens are joined with spaces;
                                        a single existing path is read as a
                                        file)
  -p, --provider <name>                 Provider name (registered provider)
  -w, --work-dir <path>                 Working directory
  -o, --owner <id>                      Session owner ID for memo isolation
  -d, --detach                          Return launch decision without waiting
  -h, --help                            display help for command
"
`;

exports[`cli main routing > preserves top-level help output via snapshot 1`] = `
"Usage: coral-cli [options] [command]

Coral CLI — invoke providers, monitor jobs, and manage discuss sessions

Options:
  -V, --version             output the version number
  -h, --help                display help for command

Commands:
  codex [options] [agent]   Run via codex; Coral captures and binds the provider
                            profile selected in the invoking shell (built-ins:
                            CODEX_HOME, default ~/.codex; CLAUDE_CONFIG_DIR,
                            default ~/.claude).
  claude [options] [agent]  Run via claude; Coral captures and binds the
                            provider profile selected in the invoking shell
                            (built-ins: CODEX_HOME, default ~/.codex;
                            CLAUDE_CONFIG_DIR, default ~/.claude).
  jobs [options]            List live jobs across all projects (current project
                            first, then KB jobs, then other directories)
  wait                      Stream job progress (text output)
  abort [options]           Abort running jobs
  workflow [options]        Execute a workflow; binds every provider profile
                            referenced by the workflow for its full lifetime
  backend                   Backend administration and local incident inspection
  discuss                   Discussion operations
  kb                        Knowledge base operations
  expansion                 Manage expansion packages
  help [command]            display help for command
"
`;
