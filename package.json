{
  "name": "coral",
  "version": "0.10.4",
  "description": "Claude Code plugin - structured agents with Codex CLI bridge",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#src/*.js": "./src/*.ts",
    "#tests/*.js": "./tests/*.ts",
    "#tools/*.js": "./tools/*.ts",
    "#src/*": "./src/*",
    "#tests/*": "./tests/*",
    "#tools/*": "./tools/*"
  },
  "files": [
    "dist/",
    "clients/bridge/coral-backend.cjs",
    "clients/bridge/coral-cli.cjs",
    "clients/bridge/coral-claude-appserver.cjs",
    "clients/bridge/manifest.json"
  ],
  "scripts": {
    "clean:dist": "node scripts/clean-dist.mjs",
    "build": "node scripts/clean-dist.mjs && tsc && node scripts/build-server.mjs --flavor prod",
    "build:dev": "node scripts/clean-dist.mjs && tsc && node scripts/build-server.mjs --flavor dev",
    "build:release": "node scripts/clean-dist.mjs && tsc && node scripts/build-server.mjs --flavor prod --release",
    "check:simulation": "node scripts/check-simulation.mjs",
    "dev": "CORAL_FLAVOR=dev tsc --watch",
    "lint": "eslint src/ tests/ tools/",
    "lint:fix": "eslint src/ tests/ tools/ --fix",
    "typecheck:tests": "tsc -p tsconfig/typecheck.json",
    "knip": "knip",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts' 'tools/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts' 'tools/**/*.ts'",
    "test": "node scripts/test.mjs",
    "test:integration": "vitest run --config vitest/integration.ts",
    "test:network": "CORAL_TEST_NETWORK=1 vitest run --config vitest/integration.ts tests/integration/engines/kiwi-runtime-download.integration.test.ts",
    "test:e2e": "vitest run --config vitest/e2e.ts",
    "test:e2e:lifecycle": "vitest run --config vitest/e2e-lifecycle.ts",
    "test:store-reset": "vitest run --config vitest/default.ts tests/unit/store/open-or-reset.test.ts tests/unit/store/reset-incident-parser.test.ts tests/unit/store/reset-incident-reader.test.ts tests/unit/store/reset-incident-diagnostic.test.ts tests/unit/store/reset-incident-report.test.ts tests/unit/coordinator/lifecycle-reset-authority-order.test.ts tests/unit/cli/store-reset.test.ts tests/unit/cli/store-reset-signal.test.ts tests/unit/cli/errors.test.ts tests/unit/cli/emit.test.ts tests/unit/support/store-reset-issue-template.test.ts tests/invariants/store-reset-discipline.test.ts tests/invariants/architecture-boundary.test.ts",
    "test:store-reset:integration": "vitest run --config vitest/integration.ts tests/integration/store/reset-incident-filesystem.integration.test.ts",
    "test:e2e:store-reset:build": "node scripts/run-store-reset-e2e.mjs clients/build",
    "test:e2e:store-reset:release": "node scripts/run-store-reset-e2e.mjs clients/bridge",
    "test:e2e:build": "node scripts/run-store-reset-e2e.mjs clients/build --all",
    "test:e2e:release": "node scripts/run-store-reset-e2e.mjs clients/bridge --all",
    "verify:store-reset-build": "node scripts/verify-store-reset-build-contract.mjs clients/build",
    "verify:store-reset-release": "node scripts/verify-store-reset-build-contract.mjs clients/bridge clients/build",
    "verify:kiwi-runtime-build": "node scripts/verify-kiwi-runtime-build-contract.mjs clients/build",
    "test:simulation": "vitest run --config vitest/simulation.ts",
    "simulate": "node scripts/run-simulation.mjs"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.12",
    "@orama/orama": "^3.1.18",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "kiwi-nlp": "0.23.0",
    "mammoth": "^1.12.0",
    "semver": "^7.7.4",
    "smol-toml": "^1.7.0",
    "turndown": "^7.2.2",
    "yaml": "^2.4.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.7",
    "@types/semver": "^7.7.1",
    "@types/turndown": "^5.0.6",
    "commander": "^14.0.3",
    "esbuild": "^0.27.2",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "knip": "^6.24.0",
    "prettier": "^3.8.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.0.17"
  }
}
