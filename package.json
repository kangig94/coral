{
  "name": "coral",
  "version": "0.8.2",
  "description": "Claude Code plugin - structured agents with Codex CLI bridge",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "imports": {
    "#src/*.js": "./src/*.ts",
    "#tests/*.js": "./tests/*.ts",
    "#tools/*.js": "./tools/*.ts",
    "#src/*": "./src/*",
    "#tests/*": "./tests/*",
    "#tools/*": "./tools/*"
  },
  "files": [
    "dist/",
    "bridge/coral-backend.cjs",
    "bridge/coral-cli.cjs",
    "bridge/coral-claude-appserver.cjs",
    "bridge/manifest.json"
  ],
  "scripts": {
    "clean:dist": "node scripts/clean-dist.mjs",
    "build": "node scripts/clean-dist.mjs && tsc && node scripts/build-server.mjs --flavor prod",
    "build:dev": "node scripts/clean-dist.mjs && tsc && node scripts/build-server.mjs --flavor dev",
    "build:release": "node scripts/clean-dist.mjs && tsc && node scripts/build-server.mjs --flavor prod --release",
    "check:simulation": "node scripts/check-simulation.mjs",
    "dev": "CORAL_FLAVOR=dev tsc --watch",
    "lint": "eslint src/ tests/ tools/",
    "lint:fix": "eslint src/ tests/ tools/ --fix",
    "typecheck:tests": "tsc -p tsconfig/typecheck.json",
    "prune": "ts-prune -p tsconfig/typecheck.json | grep -v 'used in module' || true",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts' 'tools/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts' 'tools/**/*.ts'",
    "test": "node scripts/test.mjs",
    "test:integration": "vitest run --config vitest/integration.ts",
    "test:e2e": "vitest run --config vitest/e2e.ts",
    "test:e2e:lifecycle": "vitest run --config vitest/e2e-lifecycle.ts",
    "test:simulation": "vitest run --config vitest/simulation.ts",
    "simulate": "node scripts/run-simulation.mjs"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.12",
    "@orama/orama": "^3.1.18",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "kiwi-nlp": "^0.23.0",
    "mammoth": "^1.12.0",
    "turndown": "^7.2.2",
    "yaml": "^2.4.2",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.7",
    "@types/turndown": "^5.0.6",
    "commander": "^14.0.3",
    "esbuild": "^0.27.2",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "ts-prune": "^0.10.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.0.17"
  }
}
