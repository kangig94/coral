{
  "name": "coral",
  "version": "0.5.2",
  "description": "Claude Code plugin - structured agents with Codex CLI bridge",
  "type": "module",
  "exports": {
    "./infra": "./dist/infra/index.js"
  },
  "files": [
    "dist/",
    "bridge/coral-backend.cjs",
    "bridge/coral-cli.cjs",
    "bridge/coral-claude-appserver.cjs",
    "bridge/manifest.json"
  ],
  "scripts": {
    "build": "tsc && node scripts/build-server.mjs --flavor prod",
    "build:dev": "tsc && node scripts/build-server.mjs --flavor dev",
    "build:release": "tsc && node scripts/build-server.mjs --flavor prod --release",
    "check:simulation": "node scripts/check-simulation.mjs",
    "dev": "CORAL_FLAVOR=dev tsc --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "test": "node scripts/test.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:lifecycle": "vitest run --config vitest.e2e-lifecycle.config.ts",
    "test:simulation": "vitest run --config vitest.simulation.config.ts",
    "simulate": "node scripts/run-simulation.mjs"
  },
  "dependencies": {
    "@orama/orama": "^3.1.18",
    "better-sqlite3": "^11.10.0",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "mammoth": "^1.12.0",
    "turndown": "^7.2.2",
    "yaml": "^2.4.2",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.7",
    "@types/turndown": "^5.0.6",
    "commander": "^14.0.3",
    "esbuild": "^0.27.2",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.0.17"
  }
}
