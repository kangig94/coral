{
  "name": "coral",
  "version": "0.4.12",
  "description": "Claude Code plugin - structured agents with Codex CLI bridge",
  "type": "module",
  "exports": {
    "./client": "./dist/client/index.js",
    "./infra": "./dist/infra/index.js"
  },
  "files": [
    "dist/",
    "bridge/coral-backend.cjs",
    "bridge/coral-ax.cjs",
    "bridge/coral-cli.cjs",
    "bridge/coral-claude-appserver.cjs",
    "bridge/manifest.json"
  ],
  "scripts": {
    "build": "tsc && node scripts/build-server.mjs",
    "build:server": "node scripts/build-server.mjs",
    "dev": "tsc --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "test": "node scripts/test.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@orama/orama": "^3.1.18",
    "mammoth": "^1.12.0",
    "turndown": "^7.2.2",
    "yaml": "^2.4.2",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.7",
    "@types/turndown": "^5.0.6",
    "commander": "^14.0.3",
    "esbuild": "^0.27.2",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.0.17"
  }
}
