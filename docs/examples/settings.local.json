{
  "permissions": {
    "allow": [
      "Bash(node *coral-cli*)"
    ]
  },
  "env": {
    "CORAL_FLAVOR": "dev"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "test -d \"/home/kang/workspace/coral\" || exit 0; CLAUDE_PLUGIN_ROOT=\"/home/kang/workspace/coral\" node \"/home/kang/workspace/coral/hooks/session-start.mjs\"",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "test -d \"/home/kang/workspace/coral\" || exit 0; CLAUDE_PLUGIN_ROOT=\"/home/kang/workspace/coral\" node \"/home/kang/workspace/coral/hooks/backend-warm-start.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "test -d \"/home/kang/workspace/coral\" || exit 0; CLAUDE_PLUGIN_ROOT=\"/home/kang/workspace/coral\" node \"/home/kang/workspace/coral/hooks/hud-auto-update.mjs\"",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "test -d \"/home/kang/workspace/coral\" || exit 0; CLAUDE_PLUGIN_ROOT=\"/home/kang/workspace/coral\" node \"/home/kang/workspace/coral/hooks/kb-promote-gate.mjs\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "test -d \"/home/kang/workspace/coral\" || exit 0; CLAUDE_PLUGIN_ROOT=\"/home/kang/workspace/coral\" node \"/home/kang/workspace/coral/hooks/post-compact.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "test -d \"/home/kang/workspace/coral\" || exit 0; CLAUDE_PLUGIN_ROOT=\"/home/kang/workspace/coral\" node \"/home/kang/workspace/coral/hooks/subagent-start.mjs\"",
            "timeout": 3
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -d \"/home/kang/workspace/coral\" || exit 0; CLAUDE_PLUGIN_ROOT=\"/home/kang/workspace/coral\" node \"/home/kang/workspace/coral/hooks/pre-compact.mjs\"",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "test -d \"/home/kang/workspace/coral\" || exit 0; CLAUDE_PLUGIN_ROOT=\"/home/kang/workspace/coral\" node \"/home/kang/workspace/coral/hooks/kb-lookup-reminder.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "test -d \"/home/kang/workspace/coral\" || exit 0; CLAUDE_PLUGIN_ROOT=\"/home/kang/workspace/coral\" node \"/home/kang/workspace/coral/hooks/kb-lookup-reminder.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -d \"/home/kang/workspace/coral\" || exit 0; CLAUDE_PLUGIN_ROOT=\"/home/kang/workspace/coral\" node \"/home/kang/workspace/coral/hooks/kb-promote-gate.mjs\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "test -d \"/home/kang/workspace/coral\" || exit 0; CLAUDE_PLUGIN_ROOT=\"/home/kang/workspace/coral\" node \"/home/kang/workspace/coral/hooks/ralph-loop.mjs\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "test -d \"/home/kang/workspace/coral\" || exit 0; CLAUDE_PLUGIN_ROOT=\"/home/kang/workspace/coral\" node \"/home/kang/workspace/coral/hooks/kb-memo-reminder.mjs\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "test -d \"/home/kang/workspace/coral\" || exit 0; CLAUDE_PLUGIN_ROOT=\"/home/kang/workspace/coral\" node \"/home/kang/workspace/coral/hooks/coral-skill-vars.mjs\"",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "test -d \"/home/kang/workspace/coral\" || exit 0; CLAUDE_PLUGIN_ROOT=\"/home/kang/workspace/coral\" node \"/home/kang/workspace/coral/hooks/kb-promote-gate.mjs\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "test -d \"/home/kang/workspace/coral\" || exit 0; CLAUDE_PLUGIN_ROOT=\"/home/kang/workspace/coral\" node \"/home/kang/workspace/coral/hooks/ralph-loop.mjs\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "test -d \"/home/kang/workspace/coral\" || exit 0; CLAUDE_PLUGIN_ROOT=\"/home/kang/workspace/coral\" node \"/home/kang/workspace/coral/hooks/coral-skill-vars.mjs\"",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "test -d \"/home/kang/workspace/coral\" || exit 0; CLAUDE_PLUGIN_ROOT=\"/home/kang/workspace/coral\" node \"/home/kang/workspace/coral/hooks/cli-resolve.mjs\"",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -d \"/home/kang/workspace/coral\" || exit 0; CLAUDE_PLUGIN_ROOT=\"/home/kang/workspace/coral\" node \"/home/kang/workspace/coral/hooks/ralph-loop.mjs\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "test -d \"/home/kang/workspace/coral\" || exit 0; CLAUDE_PLUGIN_ROOT=\"/home/kang/workspace/coral\" node \"/home/kang/workspace/coral/hooks/kb-promote-gate.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
